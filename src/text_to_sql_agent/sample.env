# --- App ---
APP_NAME=Text-to-SQL-Agent-Platform
APP_ENV=local            # local | dev | staging | prod
LOG_DIR="./logs"
DEBUG=true

DATABASE_URL=postgresql://<username>:<password>@<host:<port>/<application_database>

TEXT_TO_SQL_DATABASE_URL=postgresql://<username>:<password>@<host:<port>/<business_database>
TEXT_TO_SQL_SCHEMA=public

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536